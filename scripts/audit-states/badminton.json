{
  "_comment": "羽毛球计算器:默认视图是「极速平摊」空态;其余结果面板、提示条、精细分账各分支都在交互之后才出现,逐个声明让审计覆盖。「主题挂件-展开菜单」里菜单会盖住下方内容,审计会话里把被盖住的 .hero/.tabs/.panel/.footer 用 visibility:hidden 隐掉(只在审计里,不改页面),只看菜单本身与顶栏,免得把被菜单盖住的文字都报成人工复核。点击「计算分账」后页面会用 smooth 滚动到结果区,所以其后统一 wait 1500ms 等滚动结束再审计(机器繁忙时滚动未结束会让采样位置漂移,偶发把贴着吸顶栏的控件上边框误判)。",
  "states": [
    {
      "name": "极速-结果",
      "steps": [
        { "type": { "selector": "#q-total", "text": "240" } },
        { "wait": 400 }
      ]
    },
    {
      "name": "极速-余数提示+预览展开",
      "steps": [
        { "type": { "selector": "#q-total", "text": "100" } },
        { "click": "#q-chips .chip[data-count=\"6\"]" },
        { "eval": "document.querySelector('#q-result .preview').open = true" },
        { "wait": 400 }
      ]
    },
    {
      "name": "极速-复制成功",
      "steps": [
        { "type": { "selector": "#q-total", "text": "240" } },
        { "click": "#q-result .btn-copy" },
        { "wait": 300 },
        { "eval": "document.getElementById('toast').className = 'toast'" },
        { "wait": 300 }
      ]
    },
    {
      "name": "提示条-成功",
      "steps": [
        { "eval": "document.querySelector('.app').style.visibility = 'hidden'; var t = document.getElementById('toast'); t.textContent = '已复制，去微信/群里粘贴吧'; t.className = 'toast show'" },
        { "wait": 400 }
      ]
    },
    {
      "name": "提示条-错误",
      "steps": [
        { "eval": "document.querySelector('.app').style.visibility = 'hidden'; var t = document.getElementById('toast'); t.textContent = '最多支持 30 位球友'; t.className = 'toast show is-error'" },
        { "wait": 400 }
      ]
    },
    {
      "name": "极速-错误提示",
      "steps": [
        { "type": { "selector": "#q-total", "text": "abc" } },
        { "wait": 400 }
      ]
    },
    {
      "name": "精细-默认",
      "steps": [
        { "click": "#tab-detailed" },
        { "wait": 300 }
      ]
    },
    {
      "name": "精细-智能结果",
      "steps": [
        { "click": "#tab-detailed" },
