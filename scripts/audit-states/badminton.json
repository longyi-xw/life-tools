        { "type": { "selector": "#d-players li:nth-child(2) .p-exp", "text": "60" } },
        { "type": { "selector": "#d-players li:nth-child(3) .p-exp", "text": "20" } },
        { "click": "#d-calc" },
        { "wait": 1500 },
        { "eval": "document.querySelector('#d-result .preview').open = true" },
        { "wait": 600 }
      ]
    },
    {
      "name": "精细-直接互转",
      "steps": [
        { "click": "#tab-detailed" },
        { "type": { "selector": "#d-players li:nth-child(1) .p-exp", "text": "240" } },
        { "click": "#d-calc" },
        { "wait": 1500 }
      ]
    },
    {
      "name": "精细-组织者统一收款",
      "steps": [
        { "click": "#tab-detailed" },
        { "type": { "selector": "#d-players li:nth-child(1) .p-exp", "text": "100" } },
